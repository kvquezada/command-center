#!/usr/bin/env bash
# hq: the command-center CLI. Sets up a checkout (REPOS.md, then every CLI) and lists,
# checks and installs the CLIs registered in clis/.
# Each clis/<name>.sh defines CLI_BIN, CLI_DESC and the functions cli_version,
# cli_auth, cli_install and cli_login. See clis/README.md.
set -uo pipefail

# Resolve the repo root through the ~/.local/bin symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
	dir="$(cd -P "$(dirname "$src")" && pwd)"
	src="$(readlink "$src")"
	case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
CLIS="$ROOT/clis"

if [ -t 1 ]; then B=$'\e[1m' G=$'\e[32m' R=$'\e[31m' Y=$'\e[33m' D=$'\e[2m' N=$'\e[0m'; else B= G= R= Y= D= N=; fi

names() { for f in "$CLIS"/*.sh; do [ -e "$f" ] && basename "$f" .sh; done; }

# Run one hook of one CLI in a subshell, so CLI files can't leak into each other.
hook() { ( . "$CLIS/$1.sh" && "$2" ); }
field() { ( . "$CLIS/$1.sh" && eval "printf '%s' \"\${$2}\"" ); }
installed() { command -v "$(field "$1" CLI_BIN)" >/dev/null 2>&1; }

# status <name>: prints one row; returns 0 only if installed and logged in.
status() {
	local n="$1" bin ver acct
	bin="$(field "$n" CLI_BIN)"
	if ! installed "$n"; then
		printf '  %-10s %s%-9s%s %s\n' "$n" "$R" "missing" "$N" "$D($bin not on PATH; run: hq install $n)$N"
		return 1
	fi
	ver="$(hook "$n" cli_version 2>/dev/null | head -1)"
	if acct="$(hook "$n" cli_auth 2>/dev/null)"; then
		printf '  %-10s %s%-9s%s %s\n' "$n" "$G" "ok" "$N" "$bin ${ver:-?}${acct:+, logged in as $acct}"
		return 0
	fi
	printf '  %-10s %s%-9s%s %s\n' "$n" "$Y" "logged out" "$N" "$bin ${ver:-?}; run: hq install $n"
	return 1
}

usage() {
	cat <<EOF
Usage: hq [command] [cli...]

The command-center CLI: lists, checks and installs the CLIs your agents use.

Commands:
  help             show this help (the default)
  setup [root] [--force]
                   first-time setup: write REPOS.md from the git repos under root
                   (default \$HOME), then install and log in to every CLI.
                   --force rewrites an existing REPOS.md
  doctor [cli...]  check each CLI is installed and logged in; exits 1 if any isn't
  install [cli...] install whatever is missing, then log in (all CLIs if none named)
  update [cli...]  update installed CLIs to their latest release (all if none named)

CLIs:
EOF
	local n
	for n in $(names); do printf '  %-14s %s\n' "$n" "$(field "$n" CLI_DESC)"; done
	echo
	echo "Status:"
	for n in $(names); do status "$n"; done
	echo
	echo "${D}Add a CLI: copy clis/_template.sh.txt to clis/<name>.sh and fill it in.$N"
}

check_names() { # call in the main shell, so exit ends hq
	local n
	for n in "$@"; do
		[ -f "$CLIS/$n.sh" ] || { echo "hq: unknown CLI '$n'. Known: $(names | tr '\n' ' ')" >&2; exit 2; }
	done
}
pick() { if [ $# -eq 0 ]; then names; else printf '%s\n' "$@"; fi; }

doctor() {
	local n rc=0
	for n in $(pick "$@"); do status "$n" || rc=1; done
	return $rc
}

install() {
	local n rc=0
	for n in $(pick "$@"); do
		if ! installed "$n"; then
			echo "${B}Installing $n$N"
			hook "$n" cli_install || { echo "${R}Install of $n failed.$N"; rc=1; continue; }
			hash -r
		fi
		if installed "$n" && ! hook "$n" cli_auth >/dev/null 2>&1; then
			echo "${B}Logging in to $n$N"
			hook "$n" cli_login || rc=1
		fi
		status "$n" || rc=1
	done
	return $rc
}

update() {
	local n rc=0
	for n in $(pick "$@"); do
		if ! installed "$n"; then
			echo "${Y}Skipping $n: not installed. Run: hq install $n$N"
			rc=1
			continue
		fi
		if ! ( . "$CLIS/$n.sh" && type cli_update >/dev/null 2>&1 ); then
			echo "${Y}Skipping $n: clis/$n.sh has no cli_update.$N"
			continue
		fi
		echo "${B}Updating $n$N"
		hook "$n" cli_update || { echo "${R}Update of $n failed.$N"; rc=1; }
		hash -r
		status "$n" || rc=1
	done
	return $rc
}

# repos <root> <force>: write REPOS.md, the git repos under <root> that agents read
# before working in another repo. Skips worktrees, hidden folders (plugins, shell
# themes, tool caches), orca workspaces and this checkout, and masks credentials in
# remote URLs. Keeps an existing REPOS.md unless <force> is 1.
repos() {
	local root="$1" force="$2" out="$ROOT/REPOS.md" rows
	if [ -e "$out" ] && [ "$force" -eq 0 ]; then
		echo "  REPOS.md already exists, so your edits stay. Rerun with --force to rewrite it."
		return 0
	fi
	rows=$(find "$root" \
		\( -path "$root/.*" -o -path "$root/Library" -o -path "$root/orca" \
		   -o -name node_modules -o -name .venv -o -name venv -o -name vendor -o -name Pods \
		   -o -name .build -o -name DerivedData -o -name SourcePackages -o -name Carthage -o -name .claude \) -prune \
		-o -name .git -type d -print 2>/dev/null |
	while IFS= read -r g; do
		r="${g%/.git}"
		[ "$r" = "$ROOT" ] && continue
		date=$(git -C "$r" log -1 --format=%cs 2>/dev/null) || date="no commits"
		printf '%s\t%s\n' "$date" "$r"
	done | sort -r)

	{
		echo "# Repos"
		echo
		echo "The repos you work in, written by \`hq setup\`. Edit freely: delete repos you don't work in, and add what each one is."
		echo "Branch from and open PRs against each repo's base branch."
		printf '%s\n' "$rows" | while IFS=$'\t' read -r date r; do
			[ -n "$r" ] || continue
			remote=$(git -C "$r" remote get-url origin 2>/dev/null | sed -E 's#//[^/@]+@#//***@#')
			base=$(git -C "$r" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
			if [ -z "$base" ]; then
				base=$(git -C "$r" symbolic-ref --short HEAD 2>/dev/null)
				for b in main master; do
					git -C "$r" show-ref -q --verify "refs/heads/$b" && { base=$b; break; }
				done
			fi
			reads=()
			for f in AGENTS.md SPEC.md GLOSSARY.md docs/adr; do [ -e "$r/$f" ] && reads+=("$f"); done
			echo
			echo "## $(basename "$r")"
			echo
			echo "- Path: ${r/#$HOME/~}"
			echo "- Remote: ${remote:-none (local only, not backed up)}"
			echo "- Base branch: ${base:-unknown}"
			echo "- Last commit: $date"
			[ ${#reads[@]} -gt 0 ] && echo "- Read first: ${reads[*]}"
		done
	} > "$out"

	echo "  Wrote REPOS.md with $(grep -c '^## ' "$out") repos. Delete the ones you don't work in, and add a line on what each one is."
	if grep -q '\*\*\*@' "$out"; then
		echo "${R}  A remote URL in REPOS.md holds a credential (masked as ***@). Revoke it.$N" >&2
	fi
	return 0
}

# setup [root] [--force]: first-time setup for this checkout.
setup() {
	local a root="$HOME" force=0
	for a in "$@"; do
		case "$a" in
			--force) force=1 ;;
			-*) echo "hq: unknown option '$a'" >&2; usage >&2; exit 2 ;;
			*) root="$a" ;;
		esac
	done
	[ -d "$root" ] || { echo "hq: '$root' is not a directory" >&2; exit 2; }
	echo "${B}Repos$N"
	repos "$root" "$force"
	echo
	echo "${B}CLIs$N"
	install
}

cmd="${1:-help}"; shift || true
case "$cmd" in
	help | -h | --help) usage ;;
	setup) setup "$@" ;;
	doctor) check_names "$@"; doctor "$@" ;;
	install) check_names "$@"; install "$@" ;;
	update) check_names "$@"; update "$@" ;;
	*) echo "hq: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
